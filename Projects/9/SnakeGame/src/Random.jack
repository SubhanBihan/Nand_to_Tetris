class Random {
    static int seed;

    function void setSeed(int newSeed) {
        let seed = newSeed;
        return;
    }

    function int rand() {
        // Constante additive simple pour simuler un cycle pseudo-aléatoire
        let seed = seed + 20251;
        
        // Gestion manuelle du dépassement de capacité (overflow) 16 bits
        if (seed < 0) {
            let seed = seed - 32767 - 1;
        }
        return seed;
    }

    function int randRange(int range) {
        var int mask;
        var int ret;
        
        // Calcule le masque binaire le plus proche du range
        let mask = 1;
        while (mask < range) {
            let mask = (mask * 2) + 1;
        }
        
        // Génère et filtre jusqu'à obtenir une valeur dans les limites
        let ret = Random.rand() & mask;
        while (ret > range) {
            let ret = Random.rand() & mask;
        }
        
        return ret;
    }
}