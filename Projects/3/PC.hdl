/**
 * A 16-bit counter.
 * if      reset(t): out(t+1) = 0
 * else if load(t):  out(t+1) = in(t)
 * else if inc(t):   out(t+1) = out(t) + 1
 * else              out(t+1) = out(t)
 */
CHIP PC {
    IN in[16], inc, load, reset;
    OUT out[16];
    
    PARTS:
    Not(in= inc, out= ninc);
    Not(in= load, out= nload);
    Not(in= reset, out= nreset);

    And(a= nreset, b= nload, out= s1);
    And(a= nreset, b= load, out= s0);

    Inc16(in= Cout, out= outp1);
    Mux4Way16(a= false, b= in, c= outp1, d= false, sel[1]= s1, sel[0]= s0, out= Cin);

    Nand(a= ninc, b= s1, out= L);
    Register(in= Cin, load= L, out= Cout, out= out);
}
